        <contexts>

            <context attribute="Normal Text" lineEndContext="#pop" name="Normal Text" >

                <keyword attribute="Functions" context="#stay" String="BuiltinFunctions" />
                <keyword attribute="Logic" context="#pop" String="logic" />
                <keyword attribute="Constants" context="#pop" String="constants" />
                <keyword attribute="Keywords" context="#pop" String="keyword" />
                <Int attribute="Integer" />
                <Float attribute="Float" />

                <StringDetect attribute="Comment" context="Commentcontiune" String="#" lookAhead="1"/>

                <StringDetect attribute="Float" String="." />

                <StringDetect attribute="Logic" String="+" />
                <StringDetect attribute="Logic" String="-" />
                <StringDetect attribute="Logic" String="/" />
                <StringDetect attribute="Logic" String="*" />
                <StringDetect attribute="Logic" String="=" />
                <StringDetect attribute="Logic" String="\^" />
                <StringDetect attribute="Logic" String="!" />
                <StringDetect attribute="Logic" String="&gt;" />
                <StringDetect attribute="Logic" String="&lt;" />
                <StringDetect attribute="Logic" String=":=" />

                <RegExpr context="Qoutes" attribute="String" String="&quot;" beginRegion="RegionQoute" />
                <RegExpr context="Apostrophes" attribute="String" String="&apos;" beginRegion="RegionApostrophe" />

                <StringDetect attribute="Brackets" String="(" />
                <StringDetect attribute="Brackets" String=")" />
                <StringDetect attribute="Brackets" String="[" />
                <StringDetect attribute="Brackets" String="]" />

            </context>


            <context name="Qoutes" attribute="String" lineEndContext="#stay">
                <StringDetect context="#pop!Normal Text" attribute="String" String="&quot;" dynamic="true" endRegion="RegionQoute"/>
            </context>

            <context name="Apostrophes" attribute="String" lineEndContext="#stay">
                <StringDetect context="#pop!Normal Text" attribute="String" String="&apos;" dynamic="true" endRegion="RegionApostrophe"/>
            </context>


            <context name="Commentcontiune" attribute="Normal Text" fallthroughContext="#pop" lineEndContext="#pop">
                <IncludeRules context="##Doxygen"/>
                <StringDetect String="#" attribute="Comment" context="#pop!Commentar 1"/>
            </context>

            <context name="Commentar 1" attribute="Comment" lineEndContext="#pop">
                <IncludeRules context="##Comments"/>
            </context>

        </contexts>

